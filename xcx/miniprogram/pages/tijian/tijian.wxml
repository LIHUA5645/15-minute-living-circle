<!-- 体检参数与历史：定位 → 参数 → 一键体检 → 上次结论（第一屏是地图页，这一页从地图页「切换」面板进入） -->
<view class="ye">
  <!-- 体检中心 -->
  <view class="ka">
    <view class="ka-hang">
      <view class="qu-biao" style="margin-bottom: 0">体检中心</view>
      <view class="ka-zhi">{{diMing}}</view>
    </view>
    <view class="ka-fu" wx:if="{{zhongXinWen}}">坐标（地图坐标）：{{zhongXinWen}}</view>
    <view class="an-hang">
      <button class="an ci" bindtap="dingWei">用当前位置</button>
      <button class="an ci" bindtap="xuanDian">地图上选点</button>
      <button class="an ci" bindtap="quWoDe">我的</button>
    </view>
  </view>

  <!-- 参数 -->
  <view class="ka">
    <view class="qu-biao">目标时长</view>
    <view class="pai">
      <view
        class="pai-an {{item.on ? 'on' : ''}}"
        wx:for="{{muBiaoLie}}"
        wx:key="miao"
        data-miao="{{item.miao}}"
        bindtap="xuanMuBiao"
      >
        {{item.ming}}
      </view>
    </view>
    <view class="qu-biao" style="margin-top: 26rpx">精度档位</view>
    <view class="pai">
      <view
        class="pai-an {{item.on ? 'on' : ''}}"
        wx:for="{{dangWeiLie}}"
        wx:key="zhi"
        data-zhi="{{item.zhi}}"
        bindtap="xuanDangWei"
      >
        {{item.ming}}
      </view>
    </view>
    <view class="ka-fu">精细档网格更密、结论更准，请求也更多（百度配额有限，演示建议用「标准」）</view>
  </view>

  <!-- 体检 -->
  <view class="ka">
    <button class="an zhu" bindtap="kaiShiTiJian" disabled="{{running || !youZhongXin}}">
      {{running ? jinDu + '% 体检中' : '开始体检'}}
    </button>
    <block wx:if="{{running}}">
      <view class="jindu">
        <view class="jindu-tiao" style="width: {{jinDu}}%"></view>
      </view>
      <view class="ka-fu">{{jieDuanWen}}</view>
    </block>
    <view class="ka-fu" wx:else>共 4 步：检索设施 → 生成等时圈 → 识别盲区 → 评分。首次约 1~3 分钟</view>
  </view>

  <!-- 上次结论 -->
  <view class="ka" wx:if="{{shangCi}}">
    <view class="qu-biao">上次体检结论</view>
    <view class="fen-hang">
      <text class="fen" style="color: {{shangCiFenSe}}">{{shangCi.total}}</text>
      <text class="fen-dan">{{shangCiDengJi}} · 盲区 {{shangCi.mangquShu}} 处 · 请求 {{shangCi.qingQiuShu}} 次 · {{shangCi.shiJianWen}}</text>
    </view>
    <view class="an-hang">
      <button class="an ci" bindtap="kanBaoGao">看报告</button>
      <button class="an ci" bindtap="kanDiTu">看地图</button>
    </view>
    <view class="ka-fu">完整报告只在本机内存：小程序被系统回收后需重跑一轮体检</view>
  </view>

  <view class="ka-fu" style="text-align: center; margin-top: 24rpx">
    {{pingTai}}端 · 水域 OpenStreetMap · 底图腾讯地图
  </view>
</view>
