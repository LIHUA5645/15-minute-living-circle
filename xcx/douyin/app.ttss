/**app.wxss 全局样式
 * 上段保留 quickstart 的 reset；下段是本项目三端共用的一套设计语言（改这里三端观感一致）：
 *   主色 绿 #12a150 / 深绿 #0b7a3b / 软绿 #e9f7ef
 *   墨色 #101828（标题）· #475467（正文）· #98a2b3（辅助）· #eef2f6（分隔线）
 *   语义色 红 #e5484d（重度/告警）· 橙 #f59f00（轻度）· 蓝 #2f9bff（信息）· 紫 #7c5cff（AI）
 *   圆角 卡片 24rpx / 胶囊 999rpx；投影一律「低扩散 + 低透明」，避免糊成一团
 */
.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
}

button {
  background: initial;
}

button:focus {
  outline: 0;
}

button::after {
  border: none;
}

/* ↓↓↓ 本项目样式 ↓↓↓ */

page {
  background: #f4f6f5;
  color: #101828;
  font-size: 28rpx;
  line-height: 1.6;
}

.ye {
  padding: 28rpx 28rpx 80rpx;
}

/* ── 卡片 ── */
.ka {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 22rpx rgba(16, 24, 40, 0.05);
}
.ka-hang {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.ka-biao {
  font-size: 30rpx;
  font-weight: 600;
  color: #101828;
  letter-spacing: 0.5rpx;
}
.ka-zhi {
  font-size: 28rpx;
  color: #101828;
  max-width: 60%;
  text-align: right;
}
.ka-fu {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #98a2b3;
  line-height: 1.55;
}

/* 分区标题（带一根绿色短竖条） */
.qu-biao {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #101828;
  margin-bottom: 18rpx;
}
.qu-biao::before {
  content: '';
  width: 8rpx;
  height: 28rpx;
  border-radius: 4rpx;
  background: #12a150;
}

/* ── 按钮 ── */
.an-hang {
  display: flex;
  gap: 16rpx;
  margin-top: 22rpx;
  flex-wrap: wrap;
}
.an {
  margin: 0;
  padding: 0 30rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 500;
  transition: 0.15s;
}
/* 主按钮：绿底 + 一点下压阴影 */
.an.zhu {
  background: #12a150;
  color: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(18, 161, 80, 0.24);
}
.an.zhu2 {
  background: #12a150;
  color: #ffffff;
  flex: 1;
  box-shadow: 0 8rpx 20rpx rgba(18, 161, 80, 0.24);
}
.an.zhu[disabled],
.an.zhu2[disabled] {
  background: #cbd5dd;
  color: #ffffff;
  box-shadow: none;
}
/* 次按钮：软底 */
.an.ci {
  background: #eef2f6;
  color: #344054;
}
/* 幽灵按钮：白底描边（浮在深色/图片上时用） */
.an.bai {
  background: #ffffff;
  color: #344054;
  border: 1rpx solid #e4e9ee;
}
/* 等分：同一行几个按钮就平分（配 .an.xiao 用于一行三个） */
.an.ling {
  flex: 1;
  min-width: 0;
}
/* 一行三个按钮时收紧内边距与字号，避免文字被切（如「步行路线/导航/设为中心」） */
.an.xiao {
  padding: 0 10rpx;
  font-size: 25rpx;
}

/* ── 胶囊选择 ── */
.pai {
  display: flex;
  gap: 14rpx;
  margin-top: 14rpx;
}
.pai-an {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 16rpx;
  background: #eef2f6;
  color: #475467;
  font-size: 26rpx;
  border: 1rpx solid transparent;
}
.pai-an.on {
  background: #e9f7ef;
  color: #0b7a3b;
  border-color: #b7e4cc;
  font-weight: 600;
}

/* ── 进度 ── */
.jindu {
  margin-top: 20rpx;
  height: 14rpx;
  background: #eef2f6;
  border-radius: 999rpx;
  overflow: hidden;
}
.jindu-tiao {
  height: 14rpx;
  background: linear-gradient(90deg, #12a150, #3fd07e);
  border-radius: 999rpx;
  transition: width 0.25s;
}

/* ── 分数 ── */
.fen-hang {
  display: flex;
  align-items: flex-end;
  gap: 14rpx;
  margin-top: 10rpx;
}
.fen {
  font-size: 76rpx;
  font-weight: 700;
  line-height: 1;
  letter-spacing: -2rpx;
}
.fen-dan {
  font-size: 22rpx;
  color: #98a2b3;
  padding-bottom: 8rpx;
}

/* 等级/标签胶囊 */
.biao-qian {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1.5;
}

/* ═══════ 地图首页 ═══════ */
.ye-map {
  position: relative;
  width: 100vw;
  height: 100vh;
}
.ditu {
  width: 100vw;
  height: 100vh;
}

/* 顶部定位条 */
.ding-tiao {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  top: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(255, 255, 255, 0.97);
  border-radius: 22rpx;
  padding: 18rpx 20rpx;
  box-shadow: 0 10rpx 30rpx rgba(16, 24, 40, 0.14);
}
.ding-zuo {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
}
.ding-yuan {
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  background: #e9f7ef;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  flex: 0 0 auto;
}
.ding-zi {
  flex: 1;
  min-width: 0;
}
.ding-ming {
  font-size: 30rpx;
  font-weight: 600;
  color: #101828;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ding-fu {
  font-size: 22rpx;
  color: #98a2b3;
  margin-top: 2rpx;
}
.ding-an {
  font-size: 24rpx;
  color: #0b7a3b;
  padding: 10rpx 22rpx;
  background: #e9f7ef;
  border-radius: 999rpx;
  flex: 0 0 auto;
}

/* 定位方式小面板 */
.xuan-pan {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  top: 152rpx;
  background: #ffffff;
  border-radius: 22rpx;
  padding: 8rpx 0;
  box-shadow: 0 16rpx 40rpx rgba(16, 24, 40, 0.18);
  z-index: 6;
}
.xuan-an {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 24rpx 28rpx;
  font-size: 28rpx;
  color: #344054;
  border-bottom: 1rpx solid #f2f5f8;
}
.xuan-an:last-child {
  border-bottom: none;
}

/* 图层胶囊 */
.tuceng {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  top: 162rpx;
  white-space: nowrap;
}
.tuceng-an {
  display: inline-block;
  margin-right: 14rpx;
  background: rgba(255, 255, 255, 0.96);
  border-radius: 999rpx;
  padding: 14rpx 26rpx;
  font-size: 24rpx;
  color: #475467;
  box-shadow: 0 8rpx 20rpx rgba(16, 24, 40, 0.12);
}
.tuceng-an.on {
  background: #12a150;
  color: #ffffff;
  font-weight: 500;
}

/* 右侧常驻浮动入口（AI 助手 / 重新定位 / 我的）：不点开「切换」面板也够得着 */
.fu-an {
  position: absolute;
  right: 24rpx;
  top: 250rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  z-index: 5;
}
.fu-an-an {
  width: 84rpx;
  height: 84rpx;
  border-radius: 42rpx;
  background: rgba(255, 255, 255, 0.97);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 22rpx rgba(16, 24, 40, 0.16);
}

/* 底部区：信息卡 + 主卡 */
.di-qu {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
}

/* 主卡（底部抽屉） */
.di-ka {
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 18rpx 32rpx 48rpx;
  box-shadow: 0 -12rpx 36rpx rgba(16, 24, 40, 0.16);
}
/* 抽屉顶部的把手 */
.di-ba {
  width: 72rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #e4e9ee;
  margin: 0 auto 20rpx;
}
.di-hang {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.di-zi {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}
.di-biao {
  font-size: 30rpx;
  font-weight: 600;
  color: #101828;
}
.di-shu {
  font-size: 34rpx;
  font-weight: 700;
  color: #12a150;
}
.di-fen {
  font-size: 72rpx;
  font-weight: 700;
  line-height: 1;
  letter-spacing: -2rpx;
}
.can-hang {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid #f2f5f8;
}
.can-zi {
  font-size: 26rpx;
  color: #344054;
}
.can-jian {
  font-size: 24rpx;
  color: #98a2b3;
}
.di-jiao {
  margin-top: 20rpx;
  font-size: 20rpx;
  color: #b0b8c4;
  text-align: center;
}

/* 点地图命中的信息卡（浮在抽屉上方） */
.ka-di {
  margin: 0 20rpx 16rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx 26rpx;
  box-shadow: 0 14rpx 34rpx rgba(16, 24, 40, 0.18);
}
.ka-di-tou {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.ka-di-biaoTi {
  font-size: 30rpx;
  font-weight: 600;
  color: #101828;
  border-left: 8rpx solid #12a150;
  padding-left: 16rpx;
  border-radius: 4rpx;
}
.ka-di-guan {
  color: #98a2b3;
  font-size: 28rpx;
  padding: 0 8rpx;
}
.ka-di-hang {
  font-size: 26rpx;
  color: #475467;
  margin-top: 12rpx;
  line-height: 1.7;
}
.ka-di-jianYi {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: #f7f9fb;
  border-radius: 14rpx;
  font-size: 24rpx;
  color: #475467;
  line-height: 1.65;
}
.ka-di-fu {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #0b7a3b;
}

/* ═══════ 报告页 ═══════ */
/* 总分横条：大分数 + 等级胶囊 + 一条分档带 */
.zong-ka {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 30rpx 28rpx 26rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 22rpx rgba(16, 24, 40, 0.05);
}
.zong-tou {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.dai {
  position: relative;
  height: 16rpx;
  border-radius: 999rpx;
  background: #eef2f6;
  margin-top: 22rpx;
  overflow: hidden;
}
.dai-nei {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  border-radius: 999rpx;
  transition: width 0.4s;
}
.wei-hang {
  margin-top: 22rpx;
}
.wei-tou {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 26rpx;
  color: #344054;
}
.wei-tiao {
  margin-top: 10rpx;
  height: 14rpx;
  background: #eef2f6;
  border-radius: 999rpx;
  overflow: hidden;
}
.wei-tiao-nei {
  height: 14rpx;
  border-radius: 999rpx;
}
.warn {
  display: flex;
  gap: 12rpx;
  background: #fff8e8;
  border: 1rpx solid #ffe2b0;
  border-radius: 16rpx;
  padding: 18rpx 20rpx;
  font-size: 24rpx;
  color: #8a5a00;
  margin-top: 14rpx;
  line-height: 1.6;
}

/* 盲区条目 */
.mq {
  border: 1rpx solid #f0e0e0;
  background: #fffdfd;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-top: 18rpx;
}
.mq-tou {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.mq-id {
  font-size: 30rpx;
  font-weight: 600;
  color: #101828;
}
.mq-tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  color: #ffffff;
}
.mq-hang {
  font-size: 24rpx;
  color: #475467;
  margin-top: 10rpx;
  line-height: 1.65;
}
.mq-hang .dian {
  color: #98a2b3;
}

/* AI 卡片：用紫色区分「AI 生成」 */
.ai-ka {
  border: 1rpx solid #e7e2ff;
  background: linear-gradient(180deg, #faf9ff 0%, #ffffff 42%);
}
.ai-tou {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
/* AI 徽章：与网页端 .lt-jiQi 同一观感——品牌 logo（AIlogo.png）原图等比直出，不加底色、不做圆形裁切。
   图片真源在 xcx/common/images/ailogo.png（由根目录 AIlogo.png 等比缩放而来），
   `node scripts/tongbu-xcx.mjs` 会分发到各端 images/，视图里统一用 /images/ailogo.png 引用 */
.ai-logo {
  display: block;
  width: auto;
}
.ai-logo.xiao {
  height: 56rpx; /* 消息头像 / 卡片小徽章：对应网页端 28px */
}
.ai-logo.da {
  height: 112rpx; /* 欢迎态大徽章：对应网页端 56px */
}
/* 徽章容器只做占位与居中，视觉全部交给图片（原紫色「AI」文字圆牌 .ai-yuan 已删除） */
.ai-chi {
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  background: #f5f2ff;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
}
.ai-she {
  margin-top: 18rpx;
  border: 1rpx solid #e7e2ff;
  border-radius: 18rpx;
  overflow: hidden;
}
.ai-she-an {
  padding: 20rpx 22rpx;
  border-bottom: 1rpx solid #f0edff;
  background: #ffffff;
}
.ai-she-an:last-child {
  border-bottom: none;
}
.ai-she-an.on {
  background: #f7f5ff;
}
.ai-she-zi {
  font-size: 28rpx;
  color: #101828;
  font-weight: 500;
}
.ai-she-an.on .ai-she-zi {
  color: #7c5cff;
}
.ai-guang {
  color: #7c5cff;
  animation: ai-guang-dong 0.9s steps(2, start) infinite;
}
@keyframes ai-guang-dong {
  0%,
  100% {
    opacity: 1;
  }
  50% {
    opacity: 0;
  }
}
.ai-wen {
  margin-top: 18rpx;
  font-size: 27rpx;
  color: #344054;
  line-height: 1.85;
  white-space: pre-wrap;
}
.ai-cuo {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #b42318;
  line-height: 1.6;
}

/* ═══════ 我的 / 行式列表 ═══════ */
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f2f5f8;
}
.row:last-child {
  border-bottom: none;
}
.row-biao {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
  color: #475467;
}
.row-zhi {
  font-size: 26rpx;
  color: #101828;
  max-width: 62%;
  text-align: right;
}
.row-jian {
  color: #c3cbd6;
  font-size: 26rpx;
  margin-left: 8rpx;
}

/* 用户头部 */
.yong-hu {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.tou-xiang {
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #12a150, #3fd07e);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 600;
  flex: 0 0 auto;
}
.tou-xiang.hui {
  background: #e4e9ee;
  color: #98a2b3;
}

.input {
  background: #f7f9fb;
  border: 1rpx solid #e9eef3;
  border-radius: 16rpx;
  padding: 20rpx 22rpx;
  font-size: 28rpx;
  margin-top: 14rpx;
  color: #101828;
}
.input-biao {
  font-size: 24rpx;
  color: #98a2b3;
  margin-top: 20rpx;
}

/* ═══════ 图标（统一规则：语义图标一律 CSS 自绘，不用 emoji、不引图片资源） ═══════
   Web 端用 lucide + MorphIcon，小程序端用这套「同语义、同粗细、可继承文字色」的 CSS 图标：
   visible 里只写类名，颜色跟随 currentColor，尺寸用 rpx 固定，跨三端字形完全一致。 */
.ic {
  display: inline-block;
  position: relative;
  box-sizing: border-box;
  flex: 0 0 auto;
}
/* 定位针：圆头 + 尖尾（体检中心 / 当前位置） */
.ic-ding {
  width: 26rpx;
  height: 26rpx;
  border: 4rpx solid currentColor;
  border-radius: 50% 50% 50% 0;
  transform: rotate(-45deg);
}
.ic-ding::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: currentColor;
  transform: translate(-50%, -50%);
}
/* 准星：用当前位置 */
.ic-zhun {
  width: 28rpx;
  height: 28rpx;
  border: 3rpx solid currentColor;
  border-radius: 50%;
}
.ic-zhun::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: currentColor;
  transform: translate(-50%, -50%);
}
/* 地图：折页 */
.ic-tu {
  width: 30rpx;
  height: 26rpx;
  border: 3rpx solid currentColor;
  border-radius: 6rpx;
}
.ic-tu::before,
.ic-tu::after {
  content: '';
  position: absolute;
  top: 0;
  bottom: 0;
  border-left: 3rpx solid currentColor;
  transform: skewX(-14deg);
}
.ic-tu::before {
  left: 9rpx;
}
.ic-tu::after {
  right: 9rpx;
}
/* 参数：三档滑杆 */
.ic-can {
  width: 30rpx;
  height: 24rpx;
  background: repeating-linear-gradient(
    to bottom,
    currentColor 0,
    currentColor 3rpx,
    transparent 3rpx,
    transparent 10.5rpx
  );
  border-radius: 2rpx;
}
/* 人：头 + 肩 */
.ic-ren {
  width: 30rpx;
  height: 28rpx;
}
.ic-ren::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 0;
  width: 13rpx;
  height: 13rpx;
  border: 3rpx solid currentColor;
  border-radius: 50%;
  transform: translateX(-50%);
}
.ic-ren::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 26rpx;
  height: 12rpx;
  border: 3rpx solid currentColor;
  border-bottom: none;
  border-radius: 13rpx 13rpx 0 0;
  transform: translateX(-50%);
}
/* 提示：圆圈 + 感叹号（元素里写一个 ! 即可） */
.ic-jing {
  width: 30rpx;
  height: 30rpx;
  border: 3rpx solid currentColor;
  border-radius: 50%;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 23rpx;
  text-align: center;
}
/* 方向箭头：默认朝下，.shang 朝上，.you 朝右 */
.chev {
  width: 0;
  height: 0;
  border-left: 8rpx solid transparent;
  border-right: 8rpx solid transparent;
  border-top: 10rpx solid currentColor;
  flex: 0 0 auto;
}
.chev.shang {
  border-top: none;
  border-bottom: 10rpx solid currentColor;
}
.chev.you {
  border-top: 8rpx solid transparent;
  border-bottom: 8rpx solid transparent;
  border-left: 10rpx solid currentColor;
  border-right: none;
}

/* 抽屉底部信息行：左侧参数开关，右侧「我的」入口 */
.di-jiao-hang {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid #f2f5f8;
}
.di-lian {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 26rpx;
  color: #344054;
}
.di-lian .chev {
  color: #98a2b3;
}

/* ═══════ AI 助手（聊天页） ═══════ */
.lt-ye {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  background: #f4f6f5;
}
.lt-tou {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 28rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #f2f5f8;
}
.lt-tou-zi {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
}
.lt-an {
  font-size: 24rpx;
  color: #0b7a3b;
  background: #e9f7ef;
  border-radius: 999rpx;
  padding: 10rpx 22rpx;
  flex: 0 0 auto;
}
.lt-qu {
  flex: 1;
  padding: 24rpx 24rpx 8rpx;
  box-sizing: border-box;
}

/* 欢迎态与推荐问法 */
.lt-huan {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 70rpx 0 30rpx;
}
/* 原紫色大圆牌 .lt-huan-yuan 已删除：首屏大徽章直接用 .ai-logo.da 的 logo 图 */
.lt-huan-ming {
  margin-top: 24rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #101828;
}
.lt-huan-fu {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #98a2b3;
}
.lt-tui {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  justify-content: center;
  padding: 10rpx 8rpx;
}
.lt-tui-an {
  background: #ffffff;
  border: 1rpx solid #e9eef3;
  border-radius: 999rpx;
  padding: 14rpx 24rpx;
  font-size: 24rpx;
  color: #344054;
}

/* 消息气泡 */
.lt-hang {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-bottom: 22rpx;
}
.lt-hang.user {
  flex-direction: row-reverse;
}
.lt-xiang {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
}
.lt-qi {
  max-width: 76%;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  font-size: 27rpx;
  line-height: 1.7;
  word-break: break-all;
}
.lt-qi.ai {
  background: #ffffff;
  color: #344054;
  border-top-left-radius: 6rpx;
  box-shadow: 0 6rpx 18rpx rgba(16, 24, 40, 0.05);
}
.lt-qi.wo {
  background: #12a150;
  color: #ffffff;
  border-top-right-radius: 6rpx;
  box-shadow: 0 8rpx 20rpx rgba(18, 161, 80, 0.22);
}
.lt-qi.cuo {
  background: #fff6f6;
  color: #b42318;
  border: 1rpx solid #ffd9d9;
  border-top-left-radius: 6rpx;
  font-size: 25rpx;
}
/* 思考中：三点跳动 */
.lt-dian {
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 30rpx;
}
.lt-dian text {
  width: 12rpx;
  height: 12rpx;
  border-radius: 6rpx;
  background: #c3b8ff;
  animation: lt-tiao 1.1s infinite ease-in-out;
}
.lt-dian text:nth-child(2) {
  animation-delay: 0.18s;
}
.lt-dian text:nth-child(3) {
  animation-delay: 0.36s;
}
@keyframes lt-tiao {
  0%,
  100% {
    transform: translateY(0);
    opacity: 0.55;
  }
  40% {
    transform: translateY(-8rpx);
    opacity: 1;
  }
}

/* 导航确认卡 */
.lt-dao {
  margin: 0 24rpx 16rpx;
  padding: 22rpx 24rpx;
  background: #ffffff;
  border-radius: 22rpx;
  box-shadow: 0 10rpx 28rpx rgba(16, 24, 40, 0.12);
}
.lt-dao-tou {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

/* 读不到服务器配置时的提示条（点整条即重试） */
.lt-tishi {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 0 24rpx 12rpx;
  padding: 18rpx 22rpx;
  background: #fff5f5;
  border: 1rpx solid #ffd9d9;
  border-radius: 16rpx;
}
.lt-tishi-wen {
  flex: 1;
  min-width: 0;
  font-size: 23rpx;
  line-height: 1.5;
  color: #b42318;
  word-break: break-all;
}
.lt-tishi-an {
  flex: 0 0 auto;
  font-size: 24rpx;
  font-weight: 600;
  color: #ffffff;
  background: #e5484d;
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
}

/* 输入条 */
.lt-shu {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid #f2f5f8;
}
.lt-shu-in {
  flex: 1;
  height: 76rpx;
  background: #f7f9fb;
  border: 1rpx solid #e9eef3;
  border-radius: 999rpx;
  padding: 0 26rpx;
  font-size: 27rpx;
  color: #101828;
}
.lt-fa {
  width: 132rpx;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  border-radius: 999rpx;
  background: #12a150;
  color: #ffffff;
  font-size: 27rpx;
  box-shadow: 0 8rpx 20rpx rgba(18, 161, 80, 0.24);
  flex: 0 0 auto;
}
.lt-fa.jin {
  background: #cbd5dd;
  box-shadow: none;
}

/* ═══════ 登录页 ═══════ */
.deng-ye {
  min-height: 100vh;
  padding: 0 48rpx;
  background: linear-gradient(180deg, #e9f7ef 0%, #f4f6f5 42%);
  box-sizing: border-box;
}
.deng-tou {
  padding: 110rpx 0 46rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.deng-hui {
  width: 148rpx;
  height: 148rpx;
  border-radius: 44rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 14rpx 34rpx rgba(18, 161, 80, 0.18);
}
.deng-logo {
  width: 108rpx;
  height: 108rpx;
}
.deng-ming {
  margin-top: 26rpx;
  font-size: 38rpx;
  font-weight: 700;
  color: #101828;
  letter-spacing: 0.5rpx;
}
.deng-fu {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #667085;
}
.deng-ka {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx 30rpx 34rpx;
  box-shadow: 0 10rpx 30rpx rgba(16, 24, 40, 0.07);
}
.deng-tab {
  display: flex;
  gap: 40rpx;
  margin-bottom: 6rpx;
}
.deng-tab-an {
  font-size: 30rpx;
  color: #98a2b3;
  padding-bottom: 12rpx;
  border-bottom: 4rpx solid transparent;
}
.deng-tab-an.on {
  color: #101828;
  font-weight: 600;
  border-bottom-color: #12a150;
}
.deng-bo {
  margin-top: 34rpx;
}
.deng-ti {
  margin-top: 26rpx;
  font-size: 24rpx;
  color: #98a2b3;
  line-height: 1.6;
}
.deng-ke {
  margin-top: 30rpx;
  text-align: center;
  font-size: 26rpx;
  color: #475467;
  padding: 20rpx 0;
}
.deng-jiao {
  margin-top: 60rpx;
  text-align: center;
  font-size: 22rpx;
  color: #b0b8c4;
  line-height: 1.7;
  padding-bottom: 40rpx;
}
